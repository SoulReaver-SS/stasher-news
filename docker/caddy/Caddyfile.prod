# Production TLS terminator for stasher.news. Automatic Let's Encrypt:
# Caddy answers the HTTP-01 challenge on :80, issues/renews the cert, and
# redirects http -> https — no manual cert management. Certificates persist
# in the caddy_data named volume across restarts.
#
# Dev-only machinery (local_certs, on_demand_tls, the internal CA, the :5555
# ask endpoint) is deliberately absent — this file must never mint internal
# certs. Select it by setting CADDYFILE=./docker/caddy/Caddyfile.prod.
{
	# Let's Encrypt account contact for expiry/renewal notices. Publicly
	# visible in certificate transparency logs.
	email security@stasher.news
}

stasher.news {
	encode zstd gzip

	# Media uploads: same-origin /uploads is reverse-proxied to the media S3
	# service (SeaweedFS behind an HTTP-only proxy) so browsers can POST
	# presigned uploads and GET objects over TLS without a second host (no
	# mixed content, no extra DNS). S3 presigned POSTs target the bucket root
	# (https://stasher.news/uploads) — the key rides in the multipart form
	# fields, not the URL — so the matcher must include bare /uploads as well
	# as /uploads/<key>; otherwise the POST falls through to the app and the
	# invite gate. The bucket name `uploads` is the s3 path-style prefix, so
	# /uploads/<key> maps 1:1 to minio:9000/uploads/<key>. `minio` is the
	# legacy name: the old minio container answers it until a host migrates,
	# then the media proxy carries it as a network alias — so this upstream is
	# correct on both sides of the cutover.
	@uploads path /uploads /uploads/*
	handle @uploads {
		reverse_proxy minio:9000
	}

	# lws confirmation webhook: internal-only. lws delivers container-to-container
	# (direct to app:3000), never through the edge, so any public hit is a probe or
	# forgery attempt — 404 before the catch-all proxy.
	@webhook path /api/monero/webhook /api/monero/webhook/*
	handle @webhook {
		respond 404
	}

	handle {
		reverse_proxy app:3000 {
			# preserve the original Host so proxy.js's getDomainMapping(host) sees
			# the user-facing domain, not "app:3000"
			header_up Host {host}
			# Tell Next.js the browser-facing request was HTTPS, preserving the
			# ALB-era X-Forwarded-Proto contract (Secure cookies, crypto.subtle)
			header_up X-Forwarded-Proto https
			# overwrite (not append) the client-supplied X-Forwarded-For (audit B-2)
			header_up X-Forwarded-For {remote_host}
		}
	}
}

# Image rendering host. Client-rendered image URLs carry an imgproxy path prefix
# (NEXT_PUBLIC_IMGPROXY_URL); stored paths are root-relative, so they map 1:1
# onto this host. Cert is issued via the global Let's Encrypt automation above.
media.stasher.news {
	encode zstd gzip
	reverse_proxy imgproxy:8080
}

# Capture service host. Serves the 1200x630 og:image screenshots wired in
# components/seo.js. Cert is issued via the global Let's Encrypt automation
# above. The XFF overwrite mirrors the app block (audit B-2).
capture.stasher.news {
	encode zstd gzip
	reverse_proxy capture:5678 {
		header_up X-Forwarded-For {remote_host}
	}
}

# www -> apex. www.stasher.news resolves in DNS but had no site block, so
# www visitors got no certificate and no serve path. 301 preserves path+query.
www.stasher.news {
	redir https://stasher.news{uri} permanent
}
