PRISMA_SLOW_LOGS_MS=
GRAPHQL_SLOW_LOGS_MS=
NODE_ENV=development
COMPOSE_PROFILES='minimal,images,media,search,email,capture,domains,domains-caddy'

# Closed-beta invite gate. Comma-separated valid invite codes. Unset/empty = gate OFF (open access).
# Rotating the codes instantly revokes every device that already passed the gate.
# SITE_INVITE_CODES=summer-beta,friends-2026

############################################################################
# OPTIONAL SECRETS                                                         #
# put these in .env.local, and don't commit them to git                    #
############################################################################

# github
GITHUB_ID=
GITHUB_SECRET=

# twitter
TWITTER_ID=
TWITTER_SECRET=

# VAPID for Web Push
VAPID_MAILTO=
NEXT_PUBLIC_VAPID_PUBKEY=
VAPID_PRIVKEY=

# slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# auto social poster
TWITTER_POSTER_API_KEY=
TWITTER_POSTER_API_KEY_SECRET=
TWITTER_POSTER_ACCESS_TOKEN=
TWITTER_POSTER_ACCESS_TOKEN_SECRET=

########################################
# SNDEV STUFF WE PRESET                #
# which you can override in .env.local #
########################################

# email
LOGIN_EMAIL_SERVER=smtp://mailhog:1025
LOGIN_EMAIL_FROM=sndev@mailhog.dev

# Recovery-phrase (no-email) signup+login: set to enable the phrase provider
PHRASE_AUTH=1

# email salt
# openssl rand -hex 32
EMAIL_SALT=changeme

# Dev-only email digest encryption key (32 bytes / 0x73, base64). Production
# overrides this in .env.local; lib/env.js deny-lists this exact value.
EMAIL_MASTER_KEY=c3Nzc3Nzc3Nzc3Nzc3Nzc3Nzc3Nzc3Nzc3Nzc3Nzc3M=

# Email digest controls: EMAIL_DIGEST_ENABLED=false pauses all digest sends;
# EMAIL_DIGEST_DAILY_BUDGET caps sends per run (default 60).
EMAIL_DIGEST_ENABLED=true
EMAIL_DIGEST_DAILY_BUDGET=60

# Newsletter (Resend Marketing plane). Dev stays disabled + dry so nothing
# hits Resend from a dev stack; the sync/campaign jobs no-op with a warning.
# Secrets (RESEND_API_KEY, RESEND_WEBHOOK_SECRET, NEWSLETTER_SEGMENT_ID) go in
# .env.local only — with them unset the daily sync alerts once and skips.
NEWSLETTER_ENABLED=false
NEWSLETTER_DRY_RUN=true
NEWSLETTER_AUTO_SEND=false
NEWSLETTER_TEST_TO=delivered@resend.dev

# static things
NEXTAUTH_URL=http://localhost:3000/api/auth
SELF_URL=http://app:3000
PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme
JWT_SIGNING_PRIVATE_KEY=changeme

# nostr (NIP-57 zap receipts)
# openssl rand -hex 32
NOSTR_PRIVATE_KEY=changeme

# imgproxy
NEXT_PUBLIC_IMGPROXY_URL=http://localhost:3001
# No committed key/salt: imgproxy requires hex-encoded values and fatal-exits on
# placeholders, so local dev runs with signature checking disabled (unsigned).
# Production must set real, independently generated IMGPROXY_KEY/IMGPROXY_SALT.
# IMGPROXY_KEY=changeme
# IMGPROXY_SALT=changeme

IMGPROXY_ENABLE_WEBP_DETECTION=1
IMGPROXY_ENABLE_AVIF_DETECTION=1
IMGPROXY_MAX_ANIMATION_FRAMES=2000
IMGPROXY_MAX_SRC_RESOLUTION=50
IMGPROXY_MAX_ANIMATION_FRAME_RESOLUTION=200
IMGPROXY_READ_REQUEST_TIMEOUT=10
IMGPROXY_TIMEOUT=10
IMGPROXY_DOWNLOAD_TIMEOUT=9
IMGPROXY_ENABLE_VIDEO_THUMBNAILS=1
IMGPROXY_ALLOW_ORIGIN=*
# IMGPROXY_DEVELOPMENT_ERRORS_MODE=1
# IMGPROXY_ENABLE_DEBUG_HEADERS=true

NEXT_PUBLIC_AWS_UPLOAD_BUCKET=uploads
NEXT_PUBLIC_MEDIA_DOMAIN=localhost:4566
NEXT_PUBLIC_MEDIA_URL=http://localhost:4566/uploads

# search
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=dev-opensearch-admin
OPENSEARCH_INDEX=item
OPENSEARCH_MODEL_ID=
# dev-only seed import gate read by init-opensearch.sh
OS_ENABLE_SEED=1

# prisma db url
DATABASE_URL="postgresql://sn:changeme@db:5432/stackernews?schema=public"
DB_APP_CONNECTION_LIMIT=2
DB_WORKER_CONNECTION_LIMIT=2
DB_TRANSACTION_TIMEOUT=5000

# polling intervals
NEXT_PUBLIC_FAST_POLL_INTERVAL_MS=1000
NEXT_PUBLIC_NORMAL_POLL_INTERVAL_MS=30000
NEXT_PUBLIC_LONG_POLL_INTERVAL_MS=60000
NEXT_PUBLIC_EXTRA_LONG_POLL_INTERVAL_MS=300000

# containers can't use localhost, so we need to use the container name
IMGPROXY_URL_DOCKER=http://imgproxy:8080
MEDIA_URL_DOCKER=http://minio:9000/uploads

# media check with capture container
MEDIA_CHECK_URL_DOCKER=http://capture:5678/media

# privacy frontends: outbound youtube/x links are rendered
# through these instances instead of google/x (items/340002). must be absolute
# https urls; unset a provider to disable its rewriting. NEXT_PUBLIC_* values
# are inlined at build time, so changing an instance requires a rebuild.
NEXT_PUBLIC_INVIDIOUS_URL=https://yewtu.be
NEXT_PUBLIC_INVIDIOUS_URL_ALT=https://redirect.invidious.io
NEXT_PUBLIC_NITTER_URL=https://twiiit.com

# postgres container stuff
POSTGRES_PASSWORD=changeme
POSTGRES_USER=sn
POSTGRES_DB=stackernews

# opensearch container stuff
OPENSEARCH_INITIAL_ADMIN_PASSWORD=dev-opensearch-admin
DISABLE_SECURITY_DASHBOARDS_PLUGIN=true

# generic AWS_* pair — now only a default-chain fallback for real-AWS paths
# (mainnet, no media endpoint); no longer feeds MinIO. Obviously-fake dev
# placeholder — override with a real pair in .env.local only if a real-AWS
# path needs it here.
AWS_ACCESS_KEY_ID=dev-minio-root-key
AWS_SECRET_ACCESS_KEY=dev-minio-root-secret
# Media-store (MinIO) credentials for the app's S3 signer (presigned POST +
# deleteObjects). Dedicated vars — the S3Client gets explicit credentials so
# ambient AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY (the offsite-backup
# provider's keys in the worker env chain) can never shadow them. These are
# REQUIRED whenever a self-hosted media endpoint is configured, and double as
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD (compose interpolates them, with the
# legacy AWS_* pair as fallback). Override with a real per-machine pair in
# .env.local — the SAME pair you use for AWS_* there.
MEDIA_AWS_ACCESS_KEY_ID=dev-minio-root-key
MEDIA_AWS_SECRET_ACCESS_KEY=dev-minio-root-secret
SKIP_SSL_CERT_DOWNLOAD=1
# custom domain ACM, ELBv2
LOCALSTACK_ENDPOINT=http://aws:4566
ELB_LISTENER_ARN=arn:aws:elasticloadbalancing:us-east-1:123456789012:listener/app/sndev-lb/1234567890abcdef/1234567890abcdef

# tor proxy
TOR_PROXY=http://tor:7050/
grpc_proxy=http://tor:7050/

# CPU shares for each category
CPU_SHARES_IMPORTANT=1024
CPU_SHARES_MODERATE=512
CPU_SHARES_LOW=256

NEXT_TELEMETRY_DISABLED=1

# custom domains stuff
# local DNS server for custom domain verification, by default it's dnsmasq.
# reachable by containers on 172.30.0.2(:53), outside of docker with 0.0.0.0:53530
DOMAINS_DNS_SERVER=172.30.0.2
# custom domains debugging
NEXT_PUBLIC_CUSTOM_DOMAINS_DEBUG=1

# comma-separated list of additional allowed origins for webpack HMR, font
# loading, and other Next.js dev resources. wildcards are supported at the
# subdomain level (e.g. *.sndev). full domains also work
# (www.foo.sndev,linuxpc.local). localhost is always allowed.
#
# defaults below cover dev custom domains served via the local Caddy proxy
# (enabled by the domains-caddy profile; see the Custom domains section of the README):
# RFC-reserved .test, the made-up .sndev TLD wildcarded by dnsmasq.
ALLOWED_DEV_ORIGINS=**.sndev,**.test

# MDAST pipeline debugging
NEXT_PUBLIC_MDAST_DEBUG=0

# --- Monero (Phase 1) ---
# Stagenet only for now (mainnet is Phase 6). The `monero` compose profile is
# opt-in: run `COMPOSE_PROFILES=monero sndev start` or use `sndev monero ...`.
MONERO_NETWORK=stagenet
# Client-visible mirror of MONERO_NETWORK so the wallet-setup UI can validate
# addresses with monero-ts against the same network the server uses.
NEXT_PUBLIC_MONERO_NETWORK=stagenet
# monerod listen ports per network (stagenet 38xxx / mainnet 18xxx / testnet 28xxx).
# Override in .env.local when switching networks; the monerod entrypoint derives
# sane defaults from MONERO_NETWORK when these are unset. monero-lws reads the
# ZMQ port vars too so it agrees with monerod.
MONEROD_RPC_PORT=38081
MONEROD_ZMQ_RPC_PORT=38082
MONEROD_ZMQ_PUB_PORT=38083
MONEROD_URL=http://monerod:38081
# monero-lws derives --daemon/--sub from MONERO_NETWORK + the ZMQ port vars above
# (tcp://monerod:<port>). Leave unset to auto-derive; set explicitly here only to
# point lws at a remote/external monerod. MONEROD_URL/MONERO_LWS_URL stay manual
# per-network overrides (no auto-switch, by design — see internal ops docs).
# MONEROD_ZMQ_RPC_URL=tcp://monerod:38082
# MONEROD_ZMQ_PUB_URL=tcp://monerod:38083
MONERO_LWS_URL=https://monero-lws:8443
MONERO_LWS_ADMIN_URL=https://monero-lws:8081/admin
# Dev opts out of lws admin auth so local flows need no admin key. The
# entrypoint adds --disable-admin-auth when this is false. Prod MUST set this
# to true (see .env.production) and put the real admin key (from
# `monero-lws-admin create_admin`) in .env.local as MONERO_LWS_ADMIN_AUTH.
LWS_ADMIN_AUTH_ENABLED=false
# Empty here on purpose: with LWS_ADMIN_AUTH_ENABLED=false above, lws runs with
# --disable-admin-auth and no admin key is needed locally.
MONERO_LWS_ADMIN_AUTH=
# DEV/STAGENET ONLY: lws serves self-signed certs. Never set this in prod.
MONERO_LWS_INSECURE_TLS=true
# DEV/STAGENET ONLY: lws does not verify webhook receiver TLS (self-signed dev
# cert on the app). Prod sets this to system_ca (see .env.production).
MONERO_LWS_WEBHOOK_SSL_VERIFICATION=none
# lws TLS key+cert location. Unset in dev -> the compose named volume `lws-keys`
# is used and the entrypoint's gen-keys.sh generates a self-signed cert. Prod
# sets this to a host bind mount with a CA-signed cert+key, e.g.
# /etc/stashernews/lws-tls:/keys:ro (see internal ops docs).
# LWS_KEYS_VOLUME=
MONERO_LWS_TIMEOUT_MS=15000
MONERO_LWS_MAX_RETRIES=3
# Webhook receiver URL (lws calls this with tx-confirmation callbacks). In dev
# this is the Docker network address; in prod set it to the public URL.
LWS_WEBHOOK_URL=http://app:3000/api/monero/webhook
# Shared secret lws echoes back in the x-lws-token header. Empty in dev (no auth
# check); set a strong secret in prod.
LWS_WEBHOOK_TOKEN=
# Platform rewards wallet (§5.6 / §6.2) — the ONLY custodial component. Posting +
# territory fees land here via dedicated subaddresses; Phase 4 downvotes too. Put
# REAL stagenet values in .env.local (gitignored); these placeholders stay empty.
PLATFORM_REWARDS_ADDRESS=
PLATFORM_REWARDS_VIEW_KEY=
# The SPEND key is read ONLY by `sndev monero derive-fee-pool` (offline) and the
# worker's fee-pool auto top-up (worker/rewardsWalletObserver.js). It must never be
# present in the app runtime.
PLATFORM_REWARDS_SPEND_KEY=
REWARDS_SCAN_FROM_HEIGHT=0
# Bounty escrow wallet (A-13) — standalone wallet holding funded bounties until
# award/reclaim/rollover. The signer (api/monero/bounties.js, worker process) is
# the ONLY component that reads the SPEND key. Put REAL stagenet values in
# .env.local (gitignored); these placeholders stay empty.
BOUNTY_ESCROW_ADDRESS=
BOUNTY_ESCROW_VIEW_KEY=
BOUNTY_ESCROW_SPEND_KEY=
BOUNTY_ESCROW_SCAN_FROM_HEIGHT=0
POSTING_FEE_POOL_SIZE=2000
TERRITORY_FEE_POOL_SIZE=200
FEE_POOL_TOPUP_THRESHOLD=100   # auto top-up when AVAILABLE dips below this (worker)

# --- Encrypted DB backups (Phase 6 Task E1) ---
# Nightly pg_dump | gpg backup run by the worker (worker/dbBackup.js). BACKUP_DIR
# is the in-container mount of the `backups` compose volume. BACKUP_PUBLIC_KEY is
# the gpg recipient (fingerprint or uid) the dump is encrypted to; put a real key
# in .env.local (and optionally BACKUP_PUBLIC_KEY_FILE pointing at an armored
# pubkey the script imports before encrypting). BACKUP_S3_BUCKET is optional —
# leave empty to keep backups local only.
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30
BACKUP_PUBLIC_KEY=
BACKUP_PUBLIC_KEY_FILE=
BACKUP_S3_BUCKET=
# When BACKUP_S3_BUCKET is set, the following tune the S3-compatible upload
# (defaults shown match the dev media stack; leave empty for AWS defaults):
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ENDPOINT=http://media:9000
# BACKUP_S3_PREFIX=backups
# Explicit backup-provider credentials; when unset the default AWS credential
# chain is used:
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=

# --- Master-key backup / escrow (Phase 6 Task E2) ---
# scripts/backup-master-key.sh gpg-encrypts VIEWKEY_MASTER_KEY to BACKUP_PUBLIC_KEY
# and writes it to MASTERKEY_BACKUP_DIR, which MUST differ from BACKUP_DIR (the
# script refuses to co-locate). Run on first key provisioning + every master-key
# rotation (Task C2). An offline copy is also required.
MASTERKEY_BACKUP_DIR=

# --- Postgres WAL archiving / PITR (Phase 6 Task E3) ---
# Prod-only durability toggle. When DB_ARCHIVE_MODE=on the db container archives
# WAL segments to the wal_archive volume (mounted at /wal-archive) via
# archive_command, enabling point-in-time recovery and physical streaming
# replication. Dev stays off (single-volume, no archiving, unchanged behavior).
# Enable + restore steps are documented in the internal ops docs.
DB_ARCHIVE_MODE=off
# shared secret the app (media-check proxy + worker imgproxy) presents to capture's /media route
CAPTURE_MEDIA_TOKEN=dev-capture-token
