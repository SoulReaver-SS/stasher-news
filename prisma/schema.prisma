model Sub {
  name       String                @id @db.Citext
  id         Int                   @unique @default(autoincrement())
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @default(now()) @updatedAt @map("updated_at")
  userId     Int
  parentName String?               @db.Citext
  path       Unsupported("ltree")?

  postTypes            PostType[]
  rankingType          RankingType
  allowFreebies        Boolean     @default(true)
  desc                 String?
  status               Status      @default(ACTIVE)
  statusUpdatedAt      DateTime?
  billingType          BillingType
  billingCost          Int
  billingAutoRenew     Boolean     @default(false)
  billedLastAt         DateTime    @default(now())
  billPaidUntil        DateTime?
  postsPiconerosFilter BigInt      @default(-100000000000)
  nsfw                 Boolean     @default(false)

  // StasherNews territory-fee gate (§6.2): territory create/renew fees land on the
  // rewards wallet; billingStatus tracks PAID -> PENDING_FEE -> LAPSED. Reuses the
  // existing billedLastAt/billPaidUntil cadence in worker/territory.js.
  billingStatus  SubBillingStatus @default(PAID)
  billingPayInId Int?             @unique
  billingPayIn   PayIn?           @relation("SubBillingPayIn", fields: [billingPayInId], references: [id])

  // Turf-owner revenue (2026-08-21 design): owner-set premiums added on top of
  // the platform fee floor; 100% flows to the owner when a fee is routed
  // owner-direct, or into the multiplied platform-routed fee otherwise.
  // NOTE: no @map — camelCase physical columns. activeSubs (authed) and
  // topSubs return raw `SELECT "Sub".*` rows straight to GraphQL, so the
  // SUB_FIELDS-requested columns must exist camelCase in the DB (same
  // convention as postsPiconerosFilter).
  postPremiumPiconeros    BigInt @default(0)
  commentPremiumPiconeros BigInt @default(0)

  parent            Sub?                @relation("ParentChildren", fields: [parentName], references: [name])
  children          Sub[]               @relation("ParentChildren")
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  MuteSub           MuteSub[]
  SubSubscription   SubSubscription[]
  TerritoryTransfer TerritoryTransfer[]
  UserSubTrust      UserSubTrust[]
  subPayIn          SubPayIn[]
  itemSubs          ItemSub[]
  domain            Domain?
  branding          SubBranding?

  @@index([parentName])
  @@index([createdAt])
  @@index([userId])
  @@index([statusUpdatedAt])
  @@index([path], type: Gist)
}

// Per-territory branding for custom-domain territories.
// Stores both appearance overrides (colors, logo) and SEO metadata
// (title, tagline, favicon) on a single row keyed by subName. The
// GraphQL surface exposes logical `theme` and `seo` projections.
model SubBranding {
  subName   String   @id @db.Citext
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // appearance
  primaryColor   String?
  secondaryColor String?
  linkColor      String?
  logoId         Int?

  // discovery / SEO
  title     String?
  tagline   String?
  faviconId Int?

  sub     Sub     @relation(fields: [subName], references: [name], onDelete: Cascade, onUpdate: Cascade)
  logo    Upload? @relation("SubBrandingLogo", fields: [logoId], references: [id], onDelete: SetNull)
  favicon Upload? @relation("SubBrandingFavicon", fields: [faviconId], references: [id], onDelete: SetNull)

  @@index([logoId])
  @@index([faviconId])
}

