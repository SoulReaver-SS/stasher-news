  INVOICE_FORWARDING_CLTV_DELTA_TOO_LOW
  INVOICE_FORWARDING_FAILED
  HELD_INVOICE_UNEXPECTED_ERROR
  HELD_INVOICE_SETTLED_TOO_SLOW
  WITHDRAWAL_FAILED
  USER_CANCELLED
  SYSTEM_CANCELLED
  INVOICE_EXPIRED
  EXECUTION_FAILED
  UNKNOWN_FAILURE
}

model ItemPayIn {
  id      Int   @id @default(autoincrement())
  itemId  Int
  item    Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  payInId Int   @unique
  payIn   PayIn @relation(fields: [payInId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([itemId, payInId])
}

model SubPayIn {
  id      Int    @id @default(autoincrement())
  subName String @db.Citext
  sub     Sub    @relation(fields: [subName], references: [name], onDelete: Cascade)
  payInId Int    @unique
  payIn   PayIn  @relation(fields: [payInId], references: [id], onDelete: Cascade)

  @@index([subName])
}

model UploadPayIn {
  id       Int    @id @default(autoincrement())
  uploadId Int
  upload   Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  payInId  Int
  payIn    PayIn  @relation(fields: [payInId], references: [id], onDelete: Cascade)

  @@unique([uploadId, payInId])
  @@index([uploadId])
  @@index([payInId])
}

model PayIn {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  piconeros BigInt

  payInType           PayInType
  payInState          PayInState
  payInFailureReason  PayInFailureReason?
  payInStateChangedAt DateTime            @default(now())
  genesisId           Int? // the original payIn that was retried
  successorId         Int?                @unique // this ensures a payIn can only be retried once
  retryCount          Int                 @default(0)
  benefactorId        Int?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // StasherNews (§4.2): Monero URI / observed-tip / observed-downvote linkage
  moneroUri             String?
  paymentId             String?
  observedTipId         BigInt?
  observedDownvoteId    BigInt?
  // StasherNews fee linkage (§6.2): the rewards-wallet fee subaddress this PayIn
  // watches. The detected FeeObservations are reached via the `feeObservations`
  // back-relation (1:N — one row per partial-payment tx under the cumulative
  // fee gate, FK on FeeObservation.payInId) rather than a redundant scalar.
  moneroSubaddressMajor Int?
  moneroSubaddressMinor Int?
  // Set ONLY on owner-routed fee legs (fee: payment-ID namespace): the HMAC
  // payment ID embedded in the integrated address of moneroUri. Reverse-maps
  // lws webhook callbacks to this PayIn.
  moneroPaymentId       String? @unique @map("monero_payment_id")
  // StasherNews donation split (fee-allocation v2): the payer's chosen rewards
  // share (0-100) for a DONATE payIn. The rewardsWalletObserver copies it onto
  // the FeeObservation at attribution. null = legacy default (100% to the pool).
  donationRewardsPct    Int?

  genesis           PayIn?             @relation("PayInGenesis", fields: [genesisId], references: [id], onDelete: Cascade)
  successor         PayIn?             @relation("PayInSuccessor", fields: [successorId], references: [id], onDelete: Cascade)
  predecessor       PayIn?             @relation("PayInSuccessor")
  benefactor        PayIn?             @relation("PayInBenefactor", fields: [benefactorId], references: [id], onDelete: Cascade)
  beneficiaries     PayIn[]            @relation("PayInBenefactor")
  itemPayIn         ItemPayIn?
  subPayIn          SubPayIn?
  progeny           PayIn[]            @relation("PayInGenesis")
  pollVote          PollVote?
  uploadPayIns      UploadPayIn[]
  pendingItemUpdate PendingItemUpdate?
  // back-relations for the fee 1:1 linkages (Item.feePayIn / Sub.billingPayIn /
  // FeeObservation.payIn). The FKs live on the other side; these are the read sides.
  feeItem           Item?              @relation("ItemFeePayIn")
  feeSub            Sub?               @relation("SubBillingPayIn")
  feeObservations   FeeObservation[]
  observedSubFees   ObservedSubFee[]

  @@index([userId])
  @@index([createdAt])
  @@index([payInType])
  @@index([genesisId])
  @@index([payInState])
  @@index([benefactorId])
  @@index([payInStateChangedAt])
  @@index([userId, payInState, payInStateChangedAt, payInType])
  @@index([id, payInType, payInState, userId])
}

enum PayOutType {
  TERRITORY_REVENUE
  REWARDS_POOL
  ROUTING_FEE
  ROUTING_FEE_REFUND
  PROXY_PAYMENT
  TIP
  BOUNTY_PAYMENT
  REWARD
  INVITE_GIFT
  WITHDRAWAL
  SYSTEM_REVENUE
  BUY_CREDITS
  INVOICE_OVERPAY_SPILLOVER
  DEFUNCT_REFERRAL_ACT
  DEFUNCT_DELAYED_TERRITORY_REVENUE
}

// =====================================================================
// ==== STASHERNEWS MONERO OBSERVATION MODELS (spec §4.3)            ====
// =====================================================================
// All monetary columns are BigInt piconeros (1e-12 XMR). The relation
// syntax in the spec was malformed (fields:/references: swapped); it is
// reproduced here with correct Prisma syntax.

enum Network {
  STAGENET
  MAINNET
}

enum PrivacyMode {
  AUTO_INDEX
  MANUAL_PROOF
}

enum LwsAccountStatus {
  ACTIVE
  INACTIVE
  HIDDEN
}

enum SubaddressState {
  AVAILABLE
  ASSIGNED
  CONSUMED
}

enum ObservedState {
  PENDING
  DETECTED
  CONFIRMED
  REORGED
  EXPIRED
  EXCLUDED
}

enum ProofType {
  INDEXED
  PROVEN
}

enum DistributionStatus {
  PENDING
  SENDING
  COMPLETE
  FAILED
}

enum PayoutState {
  QUEUED
  SENT
  CONFIRMED
  FAILED
}

// Hot-wallet ops sweep: whether the ops share of a distribution was swept out.
enum OpsSweepState {
  NOT_SWEEPED
  SWEPT
  SKIPPED_LOCKED
  FAILED
}

// Rewards-wallet transaction journal (rewards accounting repair §3.3).
enum RewardsWalletTxKind {
  PAYOUT
  OPS_SWEEP
  CONSOLIDATION
}

// Bounty escrow dispatch kinds (Finding #1). LEGACY_SEPARATE_FEE records the
// separately-settled fee tx of the pre-2026-09-18 deferred-fee shape; its
// member legs and journal leg are LEGACY_SEPARATE_FEE (CHECK-enforced).
enum EscrowWalletTxKind {
  AWARD
  RECLAIM
  ROLLOVER
  LEGACY_SEPARATE_FEE
}

// Which escrow obligation one tx settles: the disposition (prize [+ fee in
// one tx]) or the legacy separately-relayed fee.
enum EscrowPaymentLeg {
  DISPOSITION
  LEGACY_SEPARATE_FEE
}

enum RewardsWalletTxState {
  PREPARED
  RELAYED
  NOT_RELAYED
}

enum RewardsReconciliationKind {
  CHECK
  APPLY
}

// StasherNews fee ledger (§6.2). Posting/territory fees land on the platform
// rewards wallet via dedicated subaddresses; the rewardsWalletObserver attributes them.
enum FeeType {
  POSTING
  TERRITORY_CREATE
  TERRITORY_BILLING
  TERRITORY_UNARCHIVE
  TERRITORY_UPDATE
  DONATE
  TIP_UNWALLETED
  BOOST
  BOUNTY_FEE
  BOUNTY_ROLLOVER
}

enum ItemFeeStatus {
  FEE_NOT_REQUIRED
  PENDING_FEE
  FEE_PAID
}

enum SubBillingStatus {
  PAID
  PENDING_FEE
  LAPSED
}

// A registered Monero wallet under observation by monero-lws.
// One row per (user, wallet) for authors; plus ONE fixed row for the platform rewards wallet.
model MoneroAccount {
  id              Int              @id @default(autoincrement())
  ownerUserId     Int?
  address         String
  label           String
  network         Network
  scanFromHeight  BigInt           @default(0)
  lastTxId        BigInt?
  lastBlockHash   String?
  status          LwsAccountStatus @default(ACTIVE)
  lwsRegisteredAt DateTime?
  createdAt       DateTime         @default(now())

  user             User?             @relation(fields: [ownerUserId], references: [id])
  viewKey          MoneroViewKey?
  subaddresses     SubaddressIndex[]
  observedTips     ObservedTip[]
  observedBounties ObservedBounty[]
  feeIntents       SubFeePidMap[]

  @@unique([address, network])
  @@index([ownerUserId])
}

// Encrypted view key (envelope encryption — never plaintext, never emailed).
model MoneroViewKey {
  id         Int       @id @default(autoincrement())
  accountId  Int       @unique
  ciphertext Bytes
  iv         Bytes
  tag        Bytes
  wrappedDek Bytes
  dekVersion Int
  createdAt  DateTime  @default(now())
  rotatedAt  DateTime?

  account MoneroAccount @relation(fields: [accountId], references: [id])
}

// Pool of pre-registered subaddress indexes for an author account.
model SubaddressIndex {
  id         Int             @id @default(autoincrement())
  accountId  Int
  majorIndex Int
  minorIndex Int
  address    String
  state      SubaddressState @default(AVAILABLE)
  createdAt  DateTime        @default(now())

  account MoneroAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, majorIndex, minorIndex])
  @@index([accountId, state])
}

// Post-unlock quality rating for Monerowalled posts. Insert-only — the
// @@unique is the locked-forever rule (no update/delete paths exist).
// Eligibility (viewer's confirmed tips >= the wall's price) is derived at
// request time; see lib/monero-wall/rating-loader.js.
model MoneroWallRating {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  itemId    Int      @map("item_id")
  userId    Int      @map("user_id")
  stars     Int
  item      Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([itemId])
  @@map("monero_wall_rating")
}

// An observed incoming tip (the non-custodial replacement for PayInBolt11).
model ObservedTip {
  id                 BigInt              @id @default(autoincrement())
  txHash             String
  postId             Int
  tipperId           Int?
  recipientAccountId Int
  recipientMajor     Int?
  recipientMinor     Int?
  paymentId          String
  piconeros          BigInt
  rankPiconeros      BigInt?
  height             Int?
  confirmations      Int                 @default(0)
  state              ObservedState       @default(DETECTED)
  proofType          ProofType           @default(INDEXED)
  exclusionReason    TipExclusionReason?
  txPrivateKey       String?
  webhookEventId     String?
  detectedAt         DateTime            @default(now())
  confirmedAt        DateTime?
  amountVerifiedAt   DateTime?

  post             Item          @relation(fields: [postId], references: [id])
  recipientAccount MoneroAccount @relation(fields: [recipientAccountId], references: [id])
  abuseSignal      AbuseSignal?

  // One Monero tx carries exactly ONE payment id, so a txHash can fund exactly
  // one tip. The global unique is the storage-layer backstop for the
  // pid-binding class of replay attacks (2026-09-19 review finding): even if a
  // claim path were ever bypassed, the same tx can never seed two tip rows.
  @@unique([txHash])
  @@unique([txHash, recipientAccountId, recipientMajor, recipientMinor])
  @@index([postId])
  @@index([state])
  @@index([state, confirmedAt])
  @@index([postId, tipperId, state])
  @@index([postId, state])
  @@index([tipperId, state, detectedAt])
  @@index([detectedAt, tipperId])
}

enum TipExclusionReason {
  DIRECT_SELF_TIP
  SELF_SEND
  CHAIN_MISMATCH
  TX_NOT_FOUND
}

// Deterministic self-tip abuse events (spec §3). One row per excluded
// ObservedTip (tipId unique). Written transactionally with every exclusion.
// Resolution fields are free-form until the moderation spec formalizes them.
enum AbuseSignalKind {
  SELF_TIP_EXCLUDED
  SELF_SEND_EXCLUDED
  CHAIN_MISMATCH_EXCLUDED
  TX_NOT_FOUND_EXCLUDED
}

model AbuseSignal {
  id            BigInt          @id @default(autoincrement())
  kind          AbuseSignalKind
  subjectUserId Int
  actorUserId   Int?
  tipId         BigInt          @unique
  postId        Int
  subName       String?         @db.Citext
  piconeros     BigInt
  txHash        String
  paymentId     String
  details       Json?
  detectedAt    DateTime        @default(now())
  resolvedAt    DateTime?
  resolution    String?

  subjectUser User        @relation("AbuseSignalSubject", fields: [subjectUserId], references: [id])
  actorUser   User?       @relation("AbuseSignalActor", fields: [actorUserId], references: [id])
  tip         ObservedTip @relation(fields: [tipId], references: [id])
  post        Item        @relation(fields: [postId], references: [id])

  @@index([subjectUserId])
  @@index([kind, detectedAt])
}

// An observed downvote payment (arrives on the platform rewards wallet).
model ObservedDownvote {
  id            BigInt        @id @default(autoincrement())
  txHash        String
  postId        Int
  downvoterId   Int?
  paymentId     String
  piconeros     BigInt
  height        Int?
  confirmations Int           @default(0)
  state         ObservedState @default(DETECTED)
  detectedAt    DateTime      @default(now())
  confirmedAt   DateTime?

  post Item @relation(fields: [postId], references: [id])

  @@unique([txHash, paymentId])
  @@index([postId])
  @@index([state, confirmedAt])
}

// An observed bounty funding payment (arrives on the bounty ESCROW wallet's
// integrated address carrying a "bn:"-namespace payment_id). The webhook
// receiver (pages/api/monero/webhook.js) drives PENDING -> DETECTED -> CONFIRMED,
// mirroring ObservedTip.
model ObservedBounty {
  id                 BigInt        @id @default(autoincrement())
  txHash             String
  postId             Int
  payerId            Int?
  recipientAccountId Int
  paymentId          String
  piconeros          BigInt
  height             Int?
  confirmations      Int           @default(0)
  state              ObservedState @default(DETECTED)
  webhookEventId     String?
  detectedAt         DateTime      @default(now())
  confirmedAt        DateTime?

  post             Item                    @relation(fields: [postId], references: [id])
  recipientAccount MoneroAccount           @relation(fields: [recipientAccountId], references: [id])
  receipts         ObservedBountyReceipt[]

  @@unique([txHash, paymentId])
  @@index([postId])
  @@index([state, confirmedAt])
}

// Bounty funding payment_id reverse map (created at URI-generation time).
model BountyPidMap {
  paymentId  String    @id
  postId     Int
  nonce      BigInt
  userId     Int
  expiresAt  DateTime
  consumedAt DateTime?
}

// One received on-chain funding payment for a bounty (A-13 underpayment
// support). A bounty is paid in as few or as many txs as the payer used;
// ObservedBounty.piconeros is the CUMULATIVE sum of its receipts, and the
// funding only confirms once that sum covers declared bounty + fee.
// (bountyId, txHash) unique makes retried webhook callbacks idempotent.
model ObservedBountyReceipt {
  id         BigInt   @id @default(autoincrement())
  bountyId   BigInt
  txHash     String
  piconeros  BigInt
  height     Int?
  detectedAt DateTime @default(now())

  bounty ObservedBounty @relation(fields: [bountyId], references: [id], onDelete: Cascade)

  // One tx = one payment id = one bounty funding, ever. Global unique is the
  // storage-layer backstop against re-attributing a real funding tx to a second
  // bounty's pid (escrow over-commitment; 2026-09-19 review finding).
  @@unique([txHash])
  @@unique([bountyId, txHash])
  @@index([bountyId])
}

// A bounty payout from the escrow wallet: award (winner), reclaim (author, after
// expiry), or rollover (full escrow balance -> rewards wallet, after expiry).
// recipientAddress is the signer's target (winner's / author's / rewards wallet);
// feePiconeros is the platform fee moved escrow -> rewards wallet on AWARD/RECLAIM.
model BountyPayment {
  id               Int               @id @default(autoincrement())
  itemId           Int
  winnerUserId     Int
  piconeros        BigInt
  feePiconeros     BigInt            @default(0)
  recipientAddress String
  kind             BountyPayoutKind  @default(AWARD)
  txHash           String?
  feeTxHash        String?
  feePendingAt     DateTime?
  height           Int?
  confirmations    Int               @default(0)
  state            BountyPayoutState @default(QUEUED)
  createdAt        DateTime          @default(now())
  sentAt           DateTime?
  confirmedAt      DateTime?

  // Settlement facts captured at dispatch (rewards accounting repair §3.1):
  // where the fee actually went and the transaction's real miner fee / received
  // amounts. Environment changes cannot retrospectively move an old fee; the
  // frozen destination is the settlement authority.
  feeRecipientAddress              String?
  networkFeePiconeros              BigInt?
  recipientReceivedPiconeros       BigInt?
  feeReceivedPiconeros             BigInt?
  feeSettlementNetworkFeePiconeros BigInt?

  item   Item @relation(fields: [itemId], references: [id])
  winner User @relation(fields: [winnerUserId], references: [id])

  escrowTransactions EscrowWalletTransaction[]

  @@index([itemId])
  @@index([state])
}

enum BountyStatus {
  UNFUNDED
  PENDING_FUNDING
  DETECTED
  FUNDED
  EXPIRED
  AWARDED
  REFUNDED
  ROLLED_OVER
}

enum BountyPayoutState {
  QUEUED
  SENT
  CONFIRMED
  FAILED
}

enum BountyPayoutKind {
  AWARD
  RECLAIM
  ROLLOVER
}

// An observed posting/territory fee payment (arrives on the platform rewards
// wallet via a DEDICATED fee subaddress — major 1 = posting, major 2 = territory).
// The rewardsWalletObserver attributes each fee output to its pending PayIn and flips the
// linked Item.feeStatus / Sub.billingStatus to paid. Phase 4's rewardsDistributor
// sums these per period. postId/subName are denormalized for the rewards ledger.
model FeeObservation {
  id                 BigInt        @id @default(autoincrement())
  txHash             String
  payInId            Int?
  feeType            FeeType
  postId             Int?
  subName            String?       @db.Citext
  recipientMajor     Int
  recipientMinor     Int
  piconeros          BigInt
  height             Int?
  confirmations      Int           @default(0)
  state              ObservedState @default(DETECTED)
  detectedAt         DateTime      @default(now())
  confirmedAt        DateTime?
  // StasherNews donation split (fee-allocation v2): the payer's chosen rewards
  // share copied from the PayIn at attribution; null = 100% to the pool.
  donationRewardsPct Int?
  // Hot-wallet receipt eligibility (rewards accounting repair §3.2): only rows
  // with walletReceipt = true AND state CONFIRMED count as hot-wallet receipts.
  // Legacy funding-time BOUNTY_FEE rows are retained as historical evidence but
  // marked false; new funding/abandonment writes no FeeObservation at all.
  walletReceipt    Boolean @default(true)
  // Exact rewards component for a receipt that needs an explicit mixed split
  // (e.g. one rollover output carrying prize + fee). NULL uses the source's
  // existing allocation rule. Enforced 0 <= rewardsPiconeros <= piconeros.
  rewardsPiconeros BigInt?
  // Issued payment id of an integrated-address platform fee receipt (always
  // recipient (0,0)); binds the receipt to exactly one SubFeePidMap intent.
  // NULL for subaddress-pool and every other receipt kind.
  paymentId        String?

  payIn PayIn? @relation(fields: [payInId], references: [id])

  @@unique([txHash, recipientMajor, recipientMinor])
  @@index([payInId])
  @@index([paymentId])
  @@index([feeType, state])
  @@index([state, confirmedAt])
}

// One weekly rewards distribution run.
model RewardDistribution {
  id                     Int                @id @default(autoincrement())
  periodStart            DateTime
  periodEnd              DateTime
  poolPiconeros          BigInt
  distributedPiconeros   BigInt             @default(0)
  rolledOverPiconeros    BigInt             @default(0)
  payoutCount            Int                @default(0)
  status                 DistributionStatus @default(PENDING)
  startedAt              DateTime?
  completedAt            DateTime?
  opsInflowPiconeros     BigInt             @default(0)
  opsRolledOverPiconeros BigInt             @default(0)
  opsAvailablePiconeros  BigInt             @default(0)
  opsSweptPiconeros      BigInt             @default(0)
  opsSweepTxHash         String?
  opsSweepState          OpsSweepState      @default(NOT_SWEEPED)
  // Cumulative RELAYED network cost already included in opsAvailablePiconeros
  // (rewards accounting repair §5). Legacy rows default to zero; unswept ops
  // carry reads as opsAvailable - opsSwept - (Fnow - this). Fees incurred after
  // creation reduce the active carry immediately, exactly once.
  opsNetworkFeesAccountedPiconeros BigInt @default(0)

  payouts            RewardPayout[]
  earns              Earn[]
  walletTransactions RewardsWalletTransaction[]
}

// A single curator payout within a distribution (real on-chain tx from the hot wallet).
model RewardPayout {
  id               Int         @id @default(autoincrement())
  distributionId   Int
  curatorId        Int
  recipientAddress String
  piconeros        BigInt
  txHash           String?
  state            PayoutState @default(QUEUED)
  createdAt        DateTime    @default(now())

  distribution RewardDistribution @relation(fields: [distributionId], references: [id])
  curator      User               @relation(fields: [curatorId], references: [id])

  @@index([distributionId])
}

// Rewards-wallet transaction journal (rewards accounting repair §3.3): one row
// per hot-wallet send, unique by (network, walletAddress, txHash). A PREPARED
// fee is not an incurred expense; only RELAYED fees count. Never stores keys,
// signed transaction blobs, or wallet credentials. RewardPayout /
// RewardDistribution remain the authority for reward and sweep principal —
// this journal is not a second payout eligibility engine. metadata is a closed
// union validated in code: payout members are
// { payoutId, recipientAddress, piconeros: decimalString }; an ops sweep stores
// its destination; consolidation stores only the primary destination and
// selfTransfer=true (principal 0).
model RewardsWalletTransaction {
  id                  BigInt               @id @default(autoincrement())
  network             Network
  walletAddress       String
  txHash              String
  kind                RewardsWalletTxKind
  accountIndex        Int
  distributionId      Int?
  principalPiconeros  BigInt
  networkFeePiconeros BigInt
  metadata            Json
  state               RewardsWalletTxState @default(PREPARED)
  preparedAt          DateTime             @default(now())
  relayAttemptedAt    DateTime?
  relayedAt           DateTime?
  // Proof-era capture (Finding #1): all five columns are written together in
  // one INSERT or all stay null (legacy rows) — migration SQL enforces the
  // all-or-nothing v1 tuple, the deferred pair triggers bind proofId to the
  // PaymentTransactionProof row, and an immutability trigger forbids changing
  // any captured fact after creation. relayProvenance is mutable relay
  // bookkeeping, not captured payment identity.
  dispatchId             String?  @unique @db.Uuid
  captureContractVersion Int?
  claimDigest            String?
  paymentClaims          Json?
  proofId                String?  @unique @db.Uuid
  relayProvenance        String?

  distribution RewardDistribution? @relation(fields: [distributionId], references: [id])
  paymentProof PaymentTransactionProof? @relation("RewardsPaymentProof")

  @@unique([network, walletAddress, txHash])
  @@index([network, walletAddress, state])
  @@index([distributionId])
}

// Bounty escrow dispatch journal (Finding #1): one row per escrow send, always
// a complete proof-era capture (no legacy rows — legacy escrow history is
// recovered read-only, never synthesized). Unique by scope triple and by
// (network, walletAddress, bountyPaymentId, leg): one tx per escrow leg, so an
// attempted leg can never gain a competing hash. itemId is frozen attribution
// checked against its BountyPayment inside preparation; there is deliberately
// no second Item relation. Immutable captured facts (identity, claims, kind,
// leg, attribution, principal, fee, metadata) are protected by the migration's
// trigger; state/timestamps/relayProvenance follow the existing journal rules.
model EscrowWalletTransaction {
  id                     BigInt               @id @default(autoincrement())
  network                Network
  walletAddress          String
  txHash                 String
  dispatchId             String               @unique @db.Uuid
  proofId                String               @unique @db.Uuid
  captureContractVersion Int
  claimDigest            String
  paymentClaims          Json
  kind                   EscrowWalletTxKind
  leg                    EscrowPaymentLeg
  bountyPaymentId        Int
  itemId                 Int
  accountIndex           Int
  principalPiconeros     BigInt
  networkFeePiconeros    BigInt
  metadata               Json
  state                  RewardsWalletTxState @default(PREPARED)
  preparedAt             DateTime             @default(now())
  relayAttemptedAt       DateTime?
  relayedAt              DateTime?
  relayProvenance        String?

  bountyPayment BountyPayment            @relation(fields: [bountyPaymentId], references: [id], onDelete: Restrict)
  paymentProof  PaymentTransactionProof? @relation("EscrowPaymentProof")

  @@unique([network, walletAddress, txHash])
  @@unique([network, walletAddress, bountyPaymentId, leg])
  @@index([network, walletAddress, state])
}

// The encrypted payment-proof envelope (Finding #1): exactly one owner — the
// hot rewards journal OR the escrow dispatch journal (CHECK + deferred pair
// triggers). Rows are self-authenticating EnvelopeV1 material bound to the
// canonical claims (claimDigest/bindingDigest); byte fields are the GCM
// nonces/tags/ciphertext/wrapped DEK. Owner linkage and claimDigest are
// immutable; rotation may replace envelope bytes/headers only with an
// increasing revision. Full-envelope reads are confined to the proof store
// (and the separately authorized rotation task) — public surfaces read
// inventory metadata only.
model PaymentTransactionProof {
  id               String   @id @db.Uuid
  rewardsJournalId BigInt?  @unique
  escrowJournalId  BigInt?  @unique
  revision         Int      @default(1)
  masterKeyVersion Int
  bindingVersion   Int
  envelopeVersion  Int
  payloadVersion   Int
  claimDigest      String
  bindingDigest    String
  dataNonce        Bytes
  dataTag          Bytes
  ciphertext       Bytes
  wrapNonce        Bytes
  wrapTag          Bytes
  wrappedDek       Bytes
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rewardsJournal RewardsWalletTransaction? @relation("RewardsPaymentProof", fields: [rewardsJournalId], references: [id], onDelete: Restrict)
  escrowJournal  EscrowWalletTransaction?  @relation("EscrowPaymentProof", fields: [escrowJournalId], references: [id], onDelete: Restrict)
}

// Idempotent reconciliation application audit (rewards accounting repair §8):
// a CHECK run persists its read-only evidence; an APPLY run is keyed by the
// manifest digest so duplicate application is a no-op. The table supports CHECK
// evidence publication only when an operator explicitly requests it.
model RewardsWalletReconciliation {
  id                     BigInt                     @id @default(autoincrement())
  digest                 String
  kind                   RewardsReconciliationKind
  network                Network
  walletAddress          String
  height                 Int
  blockHash              String
  ledgerFingerprint      String
  evidenceDigest         String
  positiveDriftPiconeros BigInt
  report                 Json
  backupReference        String?
  checkedAt              DateTime                   @default(now())
  appliedAt              DateTime?

  @@unique([digest, kind])
  @@index([network, walletAddress, checkedAt])
}

// Single-row (id=1) cross-process health bridge. The worker process is the only
// one that can observe lws/monerod/chain health (worker/healthProbe.js) and the
// rewards wallet's post-send balance (api/monero/rewards.js setBalanceGauge),
// while /api/metrics and /api/health run in the app process — this row is what
// carries their observations across. Readers apply the staleness window
// (lib/metrics.js HEALTH_STALE_MS, 5 min vs the probe's 60s cadence): missing/
// stale rows read as "not known up" / null. No seed row — the first upsert
// creates id=1 (fixed default, no serial sequence involved).
model HealthSnapshot {
  id               Int       @id @default(1)
  lws              Boolean?
  monerod          Boolean?
  height           Int       @default(0)
  stalled          Boolean   @default(false)
  balancePiconeros BigInt?
  balanceUpdatedAt DateTime?
  // Nightly trust walk heartbeat: written ONLY after a fully-successful run
  // (worker/trust.js gates the write on zero per-territory failures). The
  // rewards distributor's staleness fail-safe reads THIS — not
  // max(UserSubTrust.updated_at), which territory create/unarchive also
  // refresh with incidental rows.
  trustCompletedAt  DateTime?
  // Newsletter bridge (worker/newsletter.js writes on each sync; /api/health
  // and /metrics read). nullable = "not known yet" before the first sync.
  newsletterConfigured     Boolean?
  newsletterContactsActive Int?
  newsletterLastSentAt     DateTime?
  // Freshness for the newsletter bridge ONLY. The shared updatedAt is bumped by
  // healthProbe every 60s, so it cannot tell whether the newsletter last synced;
  // readers gate on THIS (stale → newsletter state reads "not known").
  newsletterSyncedAt       DateTime?
  updatedAt                DateTime  @updatedAt
}

// One row per newsletter issue. periodKey (ISO week, e.g. "2026-W41") is the
// idempotency key for the biweekly send: the weekly cron tick only builds an
// issue when no campaign has sentAt within the last 14 days, and a re-run
// updates the existing row instead of double-sending.
model NewsletterCampaign {
  id                Int       @id @default(autoincrement())
  createdAt         DateTime  @default(now())
  periodKey         String    @unique
  resendBroadcastId String?
  subject           String
  status            String
  sentAt            DateTime?
  stats             Json?
}

// Downvote payment_id reverse map (created at URI-generation time).
model DownvotePidMap {
  paymentId      String    @id
  postId         Int
  nonce          Int
  userId         Int
  expiresAt      DateTime
  consumedAt     DateTime?
  webhookEventId String?
}

// One row per on-chain RECEIPT of an owner-routed turf fee/boost (the sender
// may top up an underpayment: multiple txs share the paymentId). Born DETECTED
// at the 0-conf webhook callback; flipped CONFIRMED at N confirmations. The
// cumulative gate (sum of receipts vs the PayIn's quoted URI amount) lives in
// the webhook handler, mirroring the FeeObservation gate.
model ObservedSubFee {
  id            Int           @id @default(autoincrement())
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")
  txHash        String        @map("tx_hash")
  paymentId     String        @map("payment_id")
  payInId       Int?          @map("pay_in_id")
  payIn         PayIn?        @relation(fields: [payInId], references: [id])
  subName       String        @db.Citext
  ownerUserId   Int           @map("owner_user_id")
  piconeros     BigInt
  height        Int?
  confirmations Int           @default(0)
  state         ObservedState
  detectedAt    DateTime      @default(now()) @map("detected_at")
  confirmedAt   DateTime?     @map("confirmed_at")

  // One tx = one payment id = one fee leg, ever. Global unique is the
  // storage-layer backstop against re-attributing a real fee tx to another
  // pending pid on the same owner account (wrong-leg flips; 2026-09-19 review
  // finding).
  @@unique([txHash])
  @@unique([txHash, paymentId])
  @@index([payInId])
  @@index([subName, state])
  @@index([ownerUserId])
  @@map("ObservedSubFee")
}

// Integrated-address fee intent, one per issued fee invoice. Created at
// getInitial (before the PayIn exists), carries the lws webhook event id for
// cleanup, and is the frozen identity every receipt copies. Mirrors
// DownvotePidMap. If begin() fails the client never sees the URI, so no
// payment can arrive. Historically owner-routed only (hence the name):
//   - platform intent: feeType set, ownerUserId NULL; receipts land in
//     FeeObservation (recipient (0,0) of the rewards wallet).
//   - owner intent: feeType NULL, ownerUserId/subName set; receipts land in
//     ObservedSubFee.
// recipientAccountId + recipientAddress snapshot the receiving wallet at
// issuance (NULL only on historical owner rows, which keep owner-account
// resolution). Verification uses that account and defers if its address no
// longer equals the snapshot. Rows are retained after webhook expiry.
model SubFeePidMap {
  id                 Int            @id @default(autoincrement())
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at")
  paymentId          String         @unique @map("payment_id")
  subName            String?        @db.Citext
  ownerUserId        Int?           @map("owner_user_id")
  amountPiconeros    BigInt         @map("amount_piconeros")
  webhookEventId     String?        @map("webhook_event_id")
  expiresAt          DateTime       @map("expires_at")
  recipientAccountId Int?           @map("recipient_account_id")
  recipientAccount   MoneroAccount? @relation(fields: [recipientAccountId], references: [id], onDelete: Restrict)
  recipientAddress   String?        @map("recipient_address")
  feeType            FeeType?       @map("fee_type")
  postId             Int?           @map("post_id")

  @@index([expiresAt])
  @@index([recipientAccountId])
  @@map("SubFeePidMap")
}

// Fee configuration (platform-wide singleton row, id=1).
model PlatformFeeConfig {
  id                             Int    @id @default(1)
  requiredConfirmations          Int    @default(10)
  minTipPiconeros                BigInt @default(100000000)
  // Tip-ranking devaluation (spec §4): per-tipper cap + account-age factor for
  // attributed tips; collective cap + factor for anonymous tips.
  tipRankCapPiconeros            BigInt @default(100000000000)
  tipRankFactorFloor             Float  @default(0.7)
  tipRankRampDays                Int    @default(14)
  anonTipRankCapPiconeros        BigInt @default(100000000000)
  anonTipRankFactor              Float  @default(0.7)
  defaultDownvotePiconeros       BigInt @default(1000000000)
  downvoteMinPiconeros           BigInt @default(100000000)
  freePostThresholdPiconeros     BigInt @default(10000000000)
  freePostMinAgeDays             Int    @default(7)
  postingFeeFloorPiconeros       BigInt @default(1000000000)
  // Flat comment/reply fee (spec 2026-09-18-comment-fee-config): decoupled
  // from the posting floor so comments can be priced below posts. 6e8 = 0.0006 XMR.
  commentFeePiconeros            BigInt @default(600000000)
  territoryMonthlyPiconeros      BigInt @default(20000000000)
  territoryYearlyPiconeros       BigInt @default(200000000000)
  territoryOncePiconeros         BigInt @default(1000000000000)
  maxTurfPremiumPiconeros        BigInt @default(10000000000) @map("max_turf_premium_piconeros")
  // allocation to rewards vs ops, per source (accounting-level; §6.4)
  downvoteRewardsPct             Int    @default(100)
  postingFeeRewardsPct           Int    @default(70)
  territoryFeeRewardsPct         Int    @default(30)
  // wallet-less author tips (TIP_UNWALLETED): % of inflow allocated to the
  // curator rewards pool; the remainder is the ops share. Default 70
  // (operator, 2026-08-11).
  walletlessTipRewardsPct        Int    @default(70)
  // boosts (BOOST fee observations): % of inflow allocated to the curator
  // rewards pool; the remainder is the ops share. Default 30 (operator, 2026-08-11).
  boostRewardsPct                Int    @default(30)
  // bounties (A-13): fee = max(bountyFeeMinPiconeros, bountyFeePct% of the
  // bounty), capped at 20% of the bounty -> 100% ops; expiry window in days
  // from funding confirmation.
  bountyFeeMinPiconeros          BigInt @default(10000000000)
  bountyFeePct                   Int    @default(1)
  bountyExpiryDays               Int    @default(30)
  // rewards distribution
  // Top-N curator count: 10 at launch (fewer, larger payouts); raise as the
  // platform grows — operator-tunable via the PlatformFeeConfig row.
  distributionTopN               Int    @default(10)
  distributionMinPayoutPiconeros BigInt @default(1000000000)
  // Curator trust weighting (#6, sybil hardening): each curator's reward-share
  // weight is multiplied by (curatorTrustWeightFloor + (1 - floor) * their
  // UserSubTrust score in the tipped item's turf). 1.0 (default) = disabled,
  // exactly legacy behavior; 0.5 = gentle; 0.25 = strict. A missing/stale
  // trust-walk heartbeat (HealthSnapshot.trustCompletedAt) or an empty trust
  // table forces 1.0 (fail-safe, see worker/rewardsDistributor.js).
  curatorTrustWeightFloor            Float  @default(1.0)
  // Operator-managed account exclusions from the weekly curator distribution
  // (and its referral commissions). The founder account is always excluded in
  // addition to this list. Empty (default) = founder-only behavior. Entries not
  // resolving to a positive integer are ignored with a log line. Read at
  // distribution time, so a SQL edit takes effect on the next weekly run.
  distributionExcludedCuratorIds Int[] @default([])
}

// Singleton (id=1) cache of the monerod chain tip, written by the
// confirmFinalizer cron each tick. Read-side consumers (monerowall loaders)
// need chain depth without a daemon call per request; a stale row must be
// treated as absent (see CHAIN_TIP_MAX_AGE_MS).
model ChainState {
  id          Int      @id @default(1)
  chainHeight Int
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("chain_state")
}
