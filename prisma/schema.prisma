generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Snl {
  id   Int     @id @default(autoincrement())
  live Boolean @default(false)
}

model User {
  id                      Int                  @id @default(autoincrement())
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @default(now()) @updatedAt @map("updated_at")
  name                    String?              @unique(map: "users.name_unique") @db.Citext
  email                   String?              @unique(map: "users.email_unique")
  emailVerified           DateTime?            @map("email_verified")
  emailHash               String?              @unique(map: "users.email_hash_unique")
  emailHint               String?
  emailCiphertext         String?
  emailNotifications      Boolean              @default(true)
  emailDigestSentAt       DateTime?
  newsletterOptIn         Boolean              @default(true)
  newsletterSuppressed    Boolean              @default(false)
  resendContactId         String?
  checkedNotesAt          DateTime?
  foundNotesAt            DateTime?
  apiKeyHash              String?              @unique(map: "users.apikeyhash_unique") @db.Char(64)
  apiKeyEnabled           Boolean              @default(false)
  tipRandomMin            BigInt?
  tipRandomMax            BigInt?
  bioId                   Int?
  pubkey                  String?              @unique(map: "users.pubkey_unique")
  inviteId                String?
  tipPopover              Boolean              @default(false)
  upvotePopover           Boolean              @default(false)
  lastSeenAt              DateTime?
  stackedCredits          BigInt               @default(0)
  noteAllDescendants      Boolean              @default(true)
  noteEarning             Boolean              @default(true)
  noteInvites             Boolean              @default(true)
  noteItemPiconeros       Boolean              @default(true)
  noteMentions            Boolean              @default(true)
  noteItemMentions        Boolean              @default(true)
  photoId                 Int?
  postsPiconerosFilter    BigInt?              @default(-25000000000)
  commentsPiconerosFilter BigInt?              @default(-25000000000)
  freeCommentCount        Int                  @default(0)
  freeCommentResetAt      DateTime?
  freePostCount           Int                  @default(0)
  freePostResetAt         DateTime?
  nsfwMode                Boolean              @default(false)
  fiatCurrency            String               @default("USD")
  hideFromTopUsers        Boolean              @default(false)
  imgproxyOnly            Boolean              @default(false)
  showImagesAndVideos     Boolean              @default(true)
  referrerId              Int?
  nostrPubkey             String?
  nostrAuthPubkey         String?              @unique(map: "users.nostrAuthPubkey_unique")
  phrasePubkey            String?              @unique(map: "users.phrasePubkey_unique") @db.Char(64)
  nostrCrossposting       Boolean              @default(false)
  noteBadges              Boolean              @default(true)
  noteQuests              Boolean              @default(true)
  streak                  Int?
  infected                Boolean              @default(false)
  cured                   Boolean              @default(false)
  subs                    String[]
  hideBadges              Boolean              @default(false)
  hideStashAmount         Boolean              @default(true)
  Bookmarks               Bookmark[]
  drafts                  Draft[]
  Earn                    Earn[]
  invites                 Invite[]             @relation("Invites")
  items                   Item[]               @relation("UserItems")
  mentions                Mention[]
  PushSubscriptions       PushSubscription[]
  Streak                  Streak[]
  StreakReward            StreakReward[]
  questCompletions        QuestCompletion[]
  ThreadSubscriptions     ThreadSubscription[]
  SubSubscriptions        SubSubscription[]
  Upload                  Upload[]             @relation("Uploads")
  nostrRelays             UserNostrRelay[]
  bio                     Item?                @relation(fields: [bioId], references: [id])
  invite                  Invite?              @relation(fields: [inviteId], references: [id])
  photo                   Upload?              @relation(fields: [photoId], references: [id])
  referrer                User?                @relation("referrals", fields: [referrerId], references: [id])
  referrees               User[]               @relation("referrals")
  Account                 Account[]
  Session                 Session[]
  hideBookmarks           Boolean              @default(false)
  hideGithub              Boolean              @default(true)
  hideNostr               Boolean              @default(true)
  hideTwitter             Boolean              @default(true)
  noReferralLinks         Boolean              @default(false)
  githubId                String?
  twitterId               String?
  followers               UserSubscription[]   @relation("follower")
  followees               UserSubscription[]   @relation("followee")
  diagnostics             Boolean              @default(false)
  muters                  Mute[]               @relation("muter")
  muteds                  Mute[]               @relation("muted")
  Sub                     Sub[]
  MuteSub                 MuteSub[]
  TerritoryTransfers      TerritoryTransfer[]  @relation("TerritoryTransfer_oldUser")
  TerritoryReceives       TerritoryTransfer[]  @relation("TerritoryTransfer_newUser")
  AncestorReplies         Reply[]              @relation("AncestorReplyUser")
  Replies                 Reply[]
  Reminder                Reminder[]
  ItemUserAgg             ItemUserAgg[]
  oneDayReferrals         OneDayReferral[]     @relation("OneDayReferral_referrer")
  oneDayReferrees         OneDayReferral[]     @relation("OneDayReferral_referrees")
  domainAuthRequests      DomainAuthRequest[]
  walletsUpdatedAt        DateTime?
  UserSubTrust            UserSubTrust[]
  PayIn                   PayIn[]
  CommentsViewAt          CommentsViewAt[]
  infectedBy              Infection?           @relation("Infection_infectee")
  infectedByMe            Infection[]          @relation("Infection_infector")
  curedBy                 Cure?                @relation("Cure_curee")
  curedByMe               Cure[]               @relation("Cure_curer")

  // StasherNews Monero fields (§4.2)
  moneroAddress       String?
  privacyMode         PrivacyMode?
  stackedPiconeros    BigInt       @default(0)
  downvotePiconeros   BigInt       @default(0)
  tipDefaultPiconeros BigInt       @default(1000000000)

  // back-relations for the Monero observation models
  moneroAccounts        MoneroAccount[]
  rewardPayouts         RewardPayout[]
  bountyPayments        BountyPayment[]
  abuseSignalsAsSubject AbuseSignal[]   @relation("AbuseSignalSubject")
  abuseSignalsAsActor   AbuseSignal[]   @relation("AbuseSignalActor")
  moneroWallRatings     MoneroWallRating[]

  @@index([photoId])
  @@index([createdAt], map: "users.created_at_index")
  @@index([inviteId], map: "users.inviteId_index")
  @@index([name(ops: raw("gin_trgm_ops"))], map: "users_name_trgm_idx", type: Gin)
  @@index([streak])
  @@map("users")
}

model Infection {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now()) @map("created_at")
  infecteeId Int      @unique(map: "Infection_infecteeId_unique")
  infectorId Int?
  infectee   User     @relation("Infection_infectee", fields: [infecteeId], references: [id], onDelete: Cascade)
  infector   User?    @relation("Infection_infector", fields: [infectorId], references: [id], onDelete: Cascade)

  @@index([infectorId])
}

model Cure {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  cureeId   Int      @unique(map: "Cure_cureeId_unique")
  curerId   Int?
  curee     User     @relation("Cure_curee", fields: [cureeId], references: [id], onDelete: Cascade)
  curer     User?    @relation("Cure_curer", fields: [curerId], references: [id], onDelete: Cascade)

  @@index([curerId])
}

enum OneDayReferralType {
  REFERRAL
  POST
  COMMENT
  PROFILE
  TERRITORY
}

model OneDayReferral {
  id         Int                @id @default(autoincrement())
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @default(now()) @updatedAt @map("updated_at")
  referrerId Int
  refereeId  Int
  referrer   User               @relation("OneDayReferral_referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee    User               @relation("OneDayReferral_referrees", fields: [refereeId], references: [id], onDelete: Cascade)
  type       OneDayReferralType
  typeId     String
  landing    Boolean            @default(false)

  @@index([createdAt])
  @@index([referrerId])
  @@index([refereeId])
  @@index([type, typeId])
}

model UserSubTrust {
  subName            String   @db.Citext
  userId             Int
  zapPostTrust       Float    @default(0)
  subZapPostTrust    Float    @default(0)
  zapCommentTrust    Float    @default(0)
  subZapCommentTrust Float    @default(0)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sub                Sub      @relation(fields: [subName], references: [name], onDelete: Cascade)

  @@id([userId, subName])
  @@index([subName])
}

model Mute {
  muterId   Int
  mutedId   Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  muter     User     @relation("muter", fields: [muterId], references: [id], onDelete: Cascade)
  muted     User     @relation("muted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@id([muterId, mutedId])
  @@index([mutedId, muterId])
}

enum StreakType {
  FLAME
  VERIFIED
}

model Streak {
  id        Int        @id @default(autoincrement())
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")
  startedAt DateTime
  endedAt   DateTime?
  userId    Int
  type      StreakType @default(FLAME)
  // Highest total streak level whose ladder rewards have been granted for
  // THIS run (cycles re-grant at 8, 9, ...; the marker only moves forward).
  // A job retry sees the marker and no-ops.
  rewardLevel    Int       @default(0)
  // The golden flame shield: armed when the ladder grants a cycle day 4,
  // consumed by a missed day (the run holds at its level). Never carried
  // across runs.
  goldActive Boolean @default(false)
  // The last UTC day this run was evaluated for (the guard that makes the
  // daily evaluation idempotent: a re-run for the same day is a no-op).
  lastEvaluatedDay DateTime?
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([startedAt, userId, type])
  @@index([userId], map: "Streak.userId_index")
  @@index([type])
}

enum QuestType {
  UPVOTE
  BOOST
  FIRST_RESPONDER
  TURF
}

// One row per completed quest, written by the quest sweep (worker/quests.js).
// The unique key is the idempotency guard and the notification trigger.
model QuestCompletion {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       DateTime
  quest     QuestType

  @@unique([userId, day, quest])
  @@index([day])
}

enum StreakRewardType {
  POST
  REPLY
  TURF_DISCOUNT
  BOOST
}

// Typed streak rewards (spec 2026-09-23-daily-quests, rev 3): the ledger of
// granted rewards, one row each with its own expiry. REPLY credits are banked
// per completed quest by the sweep and per rung by the ladder, consumed at
// comment creation; POST credits are granted by the ladder, consumed at post
// creation (base quota first, soonest-expiring first). TURF_DISCOUNT is
// consumed by turf creation and never stacked (grants suppressed while one is
// held). BOOST credits are the day-5 flame reward (spec
// 2026-10-05-quest-rebalance-boost-credit): one available at a time, 30-day
// expiry, consumed by exact-ID redemption on the author's own live post.
model StreakReward {
  id         Int              @id @default(autoincrement())
  createdAt  DateTime         @default(now()) @map("created_at")
  userId     Int
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  streakId   Int?
  type       StreakRewardType @default(POST)
  grantedAt  DateTime         @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  itemId     Int?

  @@index([userId, type, consumedAt, expiresAt])
  @@index([expiresAt])
}

model NostrRelay {
  addr      String           @id
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at")
  users     UserNostrRelay[]
}

model UserNostrRelay {
  userId         Int
  nostrRelayAddr String
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at")
  NostrRelay     NostrRelay @relation(fields: [nostrRelayAddr], references: [addr], onDelete: Cascade)
  User           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, nostrRelayAddr])
}

model ItemUpload {
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  itemId    Int
  uploadId  Int
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  upload    Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@id([itemId, uploadId])
  @@index([createdAt])
  @@index([itemId])
  @@index([uploadId])
}

// Post-window addendum (2026-10-04 spec): pins media reused by an item's
// addendum so the daily unreferenced-media sweep spares it while the
// addendum lives. Deliberately separate from ItemUpload — the paid editor
// reconciles THAT table from the original text and would drop addendum pins.
// Retention is fee-aware (worker/deleteUnusedImages.js): a pin retains an
// upload only when no upload fee is outstanding (paid, or free-tier from a
// registered user); a never-paid fee-bearing upload keeps its existing
// abandonment → sweep lifecycle.
model ItemAddendumUpload {
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  itemId    Int
  uploadId  Int
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  upload    Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@id([itemId, uploadId])
  @@index([uploadId])
}

// StasherNews: a fee-bearing ITEM_UPDATE (an edit that attaches >10MB uploads)
// is NOT applied in onBegin — it is stored here and applied by
// worker/rewardsWalletObserver.flipPendingToLive once the upload fee is
// observed on the rewards wallet. Applying at creation let a user attach
// >10MB media for free by dismissing the fee QR (found 2026-09-17 on post
// 351432). A never-paid row is purged by abandonFeeItems after
// FEE_ITEM_ABANDON_DAYS.
model PendingItemUpdate {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  itemId    Int
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  payInId   Int      @unique
  payIn     PayIn    @relation(fields: [payInId], references: [id], onDelete: Cascade)
  // the item's text when the edit was deferred — a mismatch at apply time means
  // the author (or an admin) edited the item while the fee was in flight; the
  // deferred edit is dropped rather than clobbering the newer one
  oldText   String?
  // the ITEM_UPDATE payInArgs, BigInt-tagged via api/payIn/lib/payInArgs.js
  args      Json

  @@index([itemId])
  @@index([createdAt])
}

// Server-side post draft (2026-09-22 spec). Pre-submission only: never an
// Item, never a PayIn. Owner-scoped; swept by abandonStaleDrafts after
// DRAFT_TTL_DAYS of inactivity. Upload pins live in DraftUpload so the
// deleteUnusedImages sweep spares media referenced by a live draft.
model Draft {
  id                           Int      @id @default(autoincrement())
  userId                       Int      @map("user_id")
  type                         String // 'DISCUSSION' | 'LINK' | 'BOUNTY' | 'POLL'
  title                        String?
  text                         String?
  url                          String?
  subName                      String?
  // per-type extras: { bountyPiconeros } | { pollOptions, pollExpiresAt }
  extra                        Json?
  moneroWallPricePiconeros     BigInt?
  moneroWallThresholdPiconeros BigInt?
  moneroWallCoversComments     Boolean?
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")
  user                         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploads                      DraftUpload[]

  @@index([userId])
  @@map("draft")
}

// Pins an Upload to a Draft so the unattached-media sweep spares it. Pin rows
// are derived from the draft text's media URLs at save time (lib/drafts.js).
model DraftUpload {
  draftId  Int @map("draft_id")
  uploadId Int @map("upload_id")
  draft    Draft  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  upload   Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@id([draftId, uploadId])
  @@index([uploadId])
  @@map("draft_upload")
}

model Upload {
  id                  Int           @id @default(autoincrement())
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at")
  type                String
  size                Int
  width               Int?
  height              Int?
  userId              Int
  paid                Boolean       @default(false)
  // Salted hash of the uploader's client IP for anonymous uploads only.
  // Never a raw IP: used solely for the anonymous outstanding-upload quota.
  ipHash              String?
  user                User          @relation("Uploads", fields: [userId], references: [id], onDelete: Cascade)
  User                User[]
  ItemUpload          ItemUpload[]
  draftUploads        DraftUpload[]
  itemAddendumUploads ItemAddendumUpload[]
  uploadPayIns        UploadPayIn[]
  subBrandingLogos    SubBranding[] @relation("SubBrandingLogo")
  subBrandingFavicons SubBranding[] @relation("SubBrandingFavicon")

  @@index([createdAt], map: "Upload.created_at_index")
  @@index([userId], map: "Upload.userId_index")
  @@index([userId, paid, createdAt], map: "Upload.userId_paid_createdAt_index")
  @@index([ipHash, paid, createdAt], map: "Upload.ipHash_paid_createdAt_index")
}

model Earn {
  id             Int                 @id @default(autoincrement())
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at")
  piconeros      BigInt
  userId         Int
  rank           Int?
  typeProportion Float?
  type           EarnType?
  typeId         Int?
  distributionId Int?
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  distribution   RewardDistribution? @relation(fields: [distributionId], references: [id], onDelete: SetNull)

  @@index([createdAt], map: "Earn.created_at_index")
  @@index([createdAt, userId], map: "Earn.created_at_userId_index")
  @@index([userId], map: "Earn.userId_index")
  @@index([distributionId], map: "Earn.distributionId_index")
}

model Invite {
  id          String   @id @default(dbgenerated("encode(gen_random_bytes(16), 'hex'::text)"))
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  userId      Int
  gift        Int?
  limit       Int?
  giftedCount Int      @default(0)
  revoked     Boolean  @default(false)
  user        User     @relation("Invites", fields: [userId], references: [id], onDelete: Cascade)
  invitees    User[]

  description String?

  @@index([createdAt], map: "Invite.created_at_index")
  @@index([userId], map: "Invite.userId_index")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Item {
  id                      Int                   @id @default(autoincrement())
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @default(now()) @updatedAt @map("updated_at")
  title                   String?
  text                    String?
  url                     String?
  userId                  Int
  parentId                Int?
  path                    Unsupported("ltree")?
  pinId                   Int?
  location                String?
  remote                  Boolean?
  subNames                String[]              @db.Citext
  // Turf repost (2026-09-24): the turf a post was CREATED in. Comment fees
  // follow this home turf (owner-direct via turfFeeRouting), so reposts never
  // scatter conversation revenue. Null for comments, bios, and pre-migration
  // multi-turf rows.
  primarySubName          String?
  statusUpdatedAt         DateTime?
  status                  Status                @default(ACTIVE)
  company                 String?
  weightedVotes           Float                 @default(0)
  subWeightedVotes        Float                 @default(0)
  boost                   BigInt                @default(0)
  promoBoostPiconeros     BigInt                @default(0)
  pollCost                Int?
  commentPiconeros        BigInt                @default(0)
  commentTipRankPiconeros BigInt                @default(0)
  commentDownPiconeros    BigInt                @default(0)
  commentCredits          BigInt                @default(0)
  commentCost             Int                   @default(0)
  commentBoost            BigInt                @default(0)
  weightedComments        Float                 @default(0)
  lastCommentAt           DateTime?
  lastTipAt               DateTime?
  ncomments               Int                   @default(0)
  nDirectComments         Int                   @default(0)
  piconeros               BigInt                @default(0)
  tipRankPiconeros        BigInt                @default(0)
  anonTipPiconeros        BigInt                @default(0)
  downPiconeros           BigInt                @default(0)
  credits                 BigInt                @default(0)
  cost                    Int                   @default(0)
  weightedDownVotes       Float                 @default(0)
  subWeightedDownVotes    Float                 @default(0)
  bio                     Boolean               @default(false)
  freebie                 Boolean               @default(false)
  deletedAt               DateTime?
  otsFile                 Bytes?
  otsHash                 String?
  imgproxyUrls            Json?
  xPreview                Json?
  noteId                  String?               @unique(map: "Item.noteId_unique")
  rootId                  Int?
  upvotes                 Int                   @default(0)
  Bookmark                Bookmark[]
  parent                  Item?                 @relation("ParentChildren", fields: [parentId], references: [id])
  children                Item[]                @relation("ParentChildren")
  pin                     Pin?                  @relation(fields: [pinId], references: [id])
  root                    Item?                 @relation("RootDescendant", fields: [rootId], references: [id])
  descendants             Item[]                @relation("RootDescendant")
  bountyAwardWinnerFor    Item[]                @relation("BountyAwardWinner")
  user                    User                  @relation("UserItems", fields: [userId], references: [id], onDelete: Cascade)
  mentions                Mention[]
  itemReferrers           ItemMention[]         @relation("referrer")
  itemReferees            ItemMention[]         @relation("referee")
  pollOptions             PollOption[]
  PollVote                PollVote[]
  threadSubscriptions     ThreadSubscription[]
  User                    User[]
  itemUploads             ItemUpload[]
  // Post-window addendum (2026-10-04 spec): one free informational edit below
  // the locked original. addendumText/addendumUpdatedAt are the displayed
  // content/time; addendumRevision is the optimistic-concurrency token (never
  // reset, so a stale tab cannot ABA-overwrite a cleared addendum). The
  // original text/url/title and their upload pins are untouched by addendum
  // writes; addendum-only media pins live in ItemAddendumUpload.
  addendumText            String?
  addendumUpdatedAt       DateTime?
  addendumRevision        Int                   @default(0)
  addendumUploads         ItemAddendumUpload[]
  uploadId                Int?
  netInvestment           BigInt                @default(0)
  feeInvestmentPiconeros  BigInt                @default(0)
  apiKey                  Boolean               @default(false)
  pollExpiresAt           DateTime?
  Ancestors               Reply[]               @relation("AncestorReplyItem")
  Replies                 Reply[]
  Reminder                Reminder[]
  ItemUserAgg             ItemUserAgg[]
  AutoSocialPost          AutoSocialPost[]
  randPollOptions         Boolean               @default(false)
  itemPayIns              ItemPayIn[]
  pendingUpdates          PendingItemUpdate[]
  CommentsViewAt          CommentsViewAt[]
  ranktop                 Float                 @default(0)
  litCenteredSum          Float                 @default(0)
  litCenteredAt           Float                 @default(0)
  ranklit                 Float                 @default(0)
  subs                    ItemSub[]
  // Note: we leave this because there's an expensive exclusion constraint
  // that depends on this column unnecessarily ... remove during next maintenance window
  subName                 String?               @db.Citext

  // StasherNews posting-fee gate (§6.2, Q8): a low-rep author's post is created
  // PENDING_FEE and invisible until the rewardsWalletObserver observes the posting fee;
  // FEE_PAID (or FEE_NOT_REQUIRED for above-threshold authors) makes it visible.
  feeStatus  ItemFeeStatus @default(FEE_NOT_REQUIRED)
  feePayInId Int?          @unique
  feePayIn   PayIn?        @relation("ItemFeePayIn", fields: [feePayInId], references: [id])

  // R01: true when this PENDING_FEE item was within free-quota terms at
  // creation (its only on-chain cost was the upload fee) — flipPendingToLive
  // consumes its free post/comment quota when the fee is observed and the
  // item goes live.
  feeQuotaEligible Boolean @default(false)

  // Bounties (A-13): the funded bounty amount + status lifecycle. UNFUNDED posts
  // are invisible until the funding payment confirms (mirrors the feeStatus gate).
  bountyPiconeros       BigInt          @default(0)
  bountyStatus          BountyStatus    @default(UNFUNDED)
  bountyConfirmedAt     DateTime?
  // Frozen escrow fee terms (rewards accounting repair, §3.1): the exact fee the
  // funding confirmation booked alongside the net prize. NULL means UNKNOWN
  // legacy terms, NOT zero — dispositions fail closed on missing terms rather
  // than recomputing under a changed fee config. Abandonment freezes 0.
  bountyFeePiconeros    BigInt?
  // A-13 award indication: the winning comment (bountyAwardedAt) and the link
  // from the bounty post to it (bountyWinnerCommentId) — set atomically in
  // the payBounty claim transaction. BountyPayment stays the historical record.
  bountyAwardedAt       DateTime?
  bountyWinnerCommentId Int?
  bountyWinnerComment   Item?           @relation("BountyAwardWinner", fields: [bountyWinnerCommentId], references: [id])
  bountyPayments        BountyPayment[]

  // Monerowall (paywalled posts). enabledAt null = no wall ever; removedAt
  // is stamped by removeMoneroWall (one-way — X/T/enabledAt are kept for
  // rating-eligibility derivation). price/threshold nullable and independent.
  // Progress/entitlement are derived from ObservedTip rows since enabledAt —
  // see lib/monero-wall/.
  moneroWallPricePiconeros     BigInt?
  moneroWallThresholdPiconeros BigInt?
  moneroWallEnabledAt          DateTime?
  moneroWallRemovedAt          DateTime?
  // discussion wall (2026-10-14): create-time-only flag — wall the comments
  // too (same X/T entitlement, one payment unlocks body + discussion); stamped
  // one-way open by openMoneroWallComments. Removing the whole wall opens the
  // discussion with it (moneroWallEnabled is the superset gate).
  moneroWallCoversComments     Boolean   @default(false)
  moneroWallCommentsRemovedAt  DateTime?

  // back-relations for observed Monero tips/downvotes (ObservedTip/ObservedDownvote)
  observedTips      ObservedTip[]
  observedDownvotes ObservedDownvote[]
  observedBounties  ObservedBounty[]
  abuseSignals      AbuseSignal[]
  moneroWallRatings MoneroWallRating[]

  @@index([uploadId])
  @@index([lastTipAt])
  @@index([bio], map: "Item.bio_index")
  @@index([createdAt], map: "Item.created_at_index")
  @@index([freebie], map: "Item.freebie_index")
  @@index([parentId], map: "Item.parentId_index")
  @@index([path], map: "Item.path_index", type: Gist)
  @@index([path], map: "Item.path_index0", type: Gist)
  @@index([pinId], map: "Item.pinId_index")
  @@index([subName])
  @@index([rootId], map: "Item.rootId_index")
  @@index([statusUpdatedAt], map: "Item.statusUpdatedAt_index")
  @@index([status], map: "Item.status_index")
  @@index([subNames], type: Gin)
  @@index([subNames, createdAt(ops: raw("timestamp_ops"))], type: Gin)
  @@index([subNames, ranktop(ops: raw("float8_ops"))], type: Gin)
  @@index([subNames, ranklit(ops: raw("float8_ops"))], type: Gin)
  @@index([subNames, downPiconeros(ops: raw("int8_ops"))], type: Gin)
  @@index([subNames, ncomments(ops: raw("int4_ops"))], type: Gin)
  @@index([userId], map: "Item.userId_index")
  @@index([weightedDownVotes], map: "Item.weightedDownVotes_index")
  @@index([weightedVotes], map: "Item.weightedVotes_index")
  @@index([cost])
  @@index([url(ops: raw("gin_trgm_ops"))], map: "Item_url_trgm_idx", type: Gin)
  @@index([boost])
  @@index([ranktop])
  @@index([ranklit])
  @@index([netInvestment])
  @@index([downPiconeros])
  @@index([ncomments])
  @@index([userId, createdAt])
  @@index([userId, ranktop])
  @@index([userId, downPiconeros])
  @@index([userId, ncomments])
}

