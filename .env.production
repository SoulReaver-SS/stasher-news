# Closed-beta invite gate. Comma-separated valid invite codes. Unset/empty = gate OFF (open access).
# Rotating the codes instantly revokes every device that already passed the gate.
# SITE_INVITE_CODES=summer-beta,friends-2026
NODE_ENV=production
# LOGIN_EMAIL_SERVER (SMTP creds incl. the Resend API key) is a secret: it must
# live in gitignored .env.local or the SOPS secrets.env — never here, this
# file is tracked. An empty value here
# would override the .env.local secret with an empty string, so leave unset.
# EMAIL_MASTER_KEY (32-byte base64) is a secret: it lives in .env.local / SOPS.
LOGIN_EMAIL_FROM=login@stasher.news
# Digest sender (distinct from login so transactional vs digest mail is
# filterable). Non-secret; the operator must verify the address/domain in
# Resend. Falls back to LOGIN_EMAIL_FROM when unset (the worker logs a warning).
DIGEST_EMAIL_FROM=notifications@stasher.news

# Newsletter (Resend Marketing plane — Contacts + Segments + Broadcasts; a
# separate quota from the transactional 100/day shared by login codes and the
# digest, so a blast can never starve them). Secrets live in .env.local/SOPS:
#   RESEND_API_KEY (Contacts+Broadcasts API; distinct from the SMTP key inside
#     LOGIN_EMAIL_SERVER)
#   RESEND_WEBHOOK_SECRET (svix signing secret for /api/resend/webhook)
#   NEWSLETTER_SEGMENT_ID (the Resend segment used as the list)
#   NEWSLETTER_EDITORIAL_FILE (optional; default /etc/stashernews/newsletter-editorial.md)
NEWSLETTER_ENABLED=true
NEWSLETTER_AUTO_SEND=false
# MUST be explicit: compose loads .env.development first, so without this prod
# would inherit development's dry-run and never create a broadcast or send.
NEWSLETTER_DRY_RUN=false
NEWSLETTER_FROM=newsletter@stasher.news
NEWSLETTER_REPLY_TO=hello@stasher.news
NEWSLETTER_TEST_TO=delivered@resend.dev

NEXTAUTH_URL=https://stasher.news
# Mainnet S3 bucket (real AWS). Local S3-compatible deployments (stagenet/dev
# MinIO) must override to `uploads` in the env where `next build` runs — Next
# inlines NEXT_PUBLIC_* at build time and .env.local beats .env.production in
# Next's loader, so the override belongs in .env.local or the build shell, NOT
# here (this file is the mainnet truth). Rebuild after changing it.
# MEDIA_AWS_* applies only to self-hosted stores (MinIO); mainnet real-AWS
# uses the default chain (AWS_* env or IAM) — leave MEDIA_AWS_* unset here.
NEXT_PUBLIC_AWS_UPLOAD_BUCKET=snuploads
NEXT_PUBLIC_IMGPROXY_URL=https://media.stasher.news/
# allow any origin on the imgproxy crop fetch; URLs are key+salt signed
IMGPROXY_ALLOW_ORIGIN=*
NEXT_PUBLIC_MEDIA_DOMAIN=m.stasher.news
PUBLIC_URL=https://stasher.news
SELF_URL=http://app:3000
grpc_proxy=http://127.0.0.1:7050
NEXT_PUBLIC_FAST_POLL_INTERVAL_MS=10000
NEXT_PUBLIC_NORMAL_POLL_INTERVAL_MS=30000
NEXT_PUBLIC_LONG_POLL_INTERVAL_MS=60000
NEXT_PUBLIC_EXTRA_LONG_POLL_INTERVAL_MS=300000
# Guarded in lib/env.js (production boot): must never be a dev localhost URL —
# new-user signup emails build their CTA links from it and an unset value throws
# at render (new URL('/post', undefined) in pages/api/auth/[...nextauth].js).
NEXT_PUBLIC_URL=https://stasher.news
TOR_PROXY=http://127.0.0.1:7050/
PRISMA_SLOW_LOGS_MS=50
GRAPHQL_SLOW_LOGS_MS=50
DB_APP_CONNECTION_LIMIT=4
DB_WORKER_CONNECTION_LIMIT=2
DB_TRANSACTION_TIMEOUT=10000
NEXT_TELEMETRY_DISABLED=1
# Prod heap: set OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g in VPS .env.local — compose
# interpolation reads the --env-file chain, NOT this container-env file
# (opensearch uses plain x-env_file). Raise if corpus/search load grows.
OPENSEARCH_INDEX=item
# OPENSEARCH_MODEL_ID is intentionally not tracked here. After the one-time prod
# bootstrap, fetch the deployed dense model id via /_plugins/_ml/models/_search
# and set OPENSEARCH_MODEL_ID in the VPS .env.local (never tracked). Unset means
# the semantic leg degrades gracefully (api/resolvers/search.js skips neural
# legs when modelId is null).

# --- Monero mainnet (Phase 6 Workstream A) ---
# Network the monerod / monero-lws stack runs on. Prod is mainnet only; stagenet
# belongs in .env.development.
MONERO_NETWORK=mainnet
# Client-visible mirror so the wallet-setup UI validates addresses with monero-ts
# against the same network the server uses.
NEXT_PUBLIC_MONERO_NETWORK=mainnet
# monerod listen ports per network (mainnet 18xxx / stagenet 38xxx / testnet 28xxx).
MONEROD_RPC_PORT=18081
MONEROD_ZMQ_RPC_PORT=18082
MONEROD_ZMQ_PUB_PORT=18083
# monerod JSON-RPC over the Docker network. monero-lws derives its --daemon/--sub
# from MONERO_NETWORK + the ZMQ port vars above (tcp://monerod:<port>); the ZMQ
# URL lines are set explicitly so lws can also be pointed at a remote monerod.
MONEROD_URL=http://monerod:18081
MONEROD_ZMQ_RPC_URL=tcp://monerod:18082
MONEROD_ZMQ_PUB_URL=tcp://monerod:18083
# monero-lws public + admin endpoints over the Docker network.
# SECURITY: the admin REST server (:8081) MUST stay private-network-only — it is
# never host-published (no `ports:` mapping on the monero-lws service in
# docker-compose.yml, by design). Do NOT add a ports mapping for 8081: only the
# app/worker on the same Docker network should reach it. (8443, the wallet REST
# server, is also private; lws is fronted by the app over the internal network.)
MONERO_LWS_URL=https://monero-lws:8443
MONERO_LWS_ADMIN_URL=https://monero-lws:8081/admin
# Prod MUST enable lws admin auth. The entrypoint adds --disable-admin-auth
# only when this is false; leaving it true (the secure default) requires the
# admin key below. NEVER set this to false in prod.
LWS_ADMIN_AUTH_ENABLED=true
# REQUIRED in prod: admin auth key from `monero-lws-admin create_admin`. Put the
# real secret in gitignored .env.local (never here — this file is tracked). With
# LWS_ADMIN_AUTH_ENABLED=true, lws rejects every admin request (account + webhook
# management) without it, so leaving it empty breaks tip observation.
MONERO_LWS_ADMIN_AUTH=
# lws serves a real cert in prod; the dev stagenet default (true) MUST NOT carry
# over. Set true only behind a trusted reverse proxy terminating TLS — never on
# the open internet.
MONERO_LWS_INSECURE_TLS=false
# lws verifies the webhook receiver's TLS against the system CA store (rejects
# self-signed). Prod ships `none` because LWS_WEBHOOK_URL above is an http://
# URL over the internal Docker network (http://app:3000 has no TLS cert, so
# system_ca verification would have nothing to verify). Dev also uses `none`
# (app serves a self-signed cert). IF you move lws to a separate host and point
# LWS_WEBHOOK_URL at a PUBLIC https URL, switch this back to `system_ca` so lws
# verifies the receiver's cert against the system CA store.
MONERO_LWS_WEBHOOK_SSL_VERIFICATION=none
# lws TLS key+cert. Prod MUST point this at a host directory holding a CA-signed
# `lws.key` + `lws.crt` (with a SAN for the hostname lws uses to call the
# webhook receiver). The entrypoint skips self-signed generation when these
# files already exist. Set in .env.local, e.g.:
#   LWS_KEYS_VOLUME=/etc/stashernews/lws-tls:/keys:ro
# Leave unset only if you have pre-populated the compose named volume by other
# means. See the internal ops docs on lws TLS hardening.
# LWS_KEYS_VOLUME=
MONERO_LWS_TIMEOUT_MS=15000
MONERO_LWS_MAX_RETRIES=3
# Webhook receiver URL (lws calls this with tx-confirmation callbacks). As long
# as lws and the app share the Docker network, the internal address is correct
# and avoids a public round-trip; switch to the public URL only if lws is split
# to a separate host.
LWS_WEBHOOK_URL=http://app:3000/api/monero/webhook
# Shared secret lws echoes back in the x-lws-token header. REQUIRED in prod (empty
# = no auth check, dev-only). Set a strong secret in .env.local.
LWS_WEBHOOK_TOKEN=

# --- Platform rewards wallet (§5.6 / §6.2) ---
# The ONLY custodial component. Posting + territory fees land here via dedicated
# subaddresses; downvotes too. The next two lines are PUBLIC transparency values
# and are safe to commit here once the mainnet wallet is provisioned (Task A6);
# leave empty until then.
PLATFORM_REWARDS_ADDRESS=
PLATFORM_REWARDS_VIEW_KEY=
# The SPEND key is a SECRET — put it ONLY in gitignored .env.local, never in this
# tracked file. It is read solely by the offline derive-fee-pool step and the
# worker's fee-pool auto top-up (worker/rewardsWalletObserver.js), never by the
# app runtime. Uncomment + set in .env.local only:
#   PLATFORM_REWARDS_SPEND_KEY=
# Rewards wallet rescan anchor + fee-pool sizing.
REWARDS_SCAN_FROM_HEIGHT=0
POSTING_FEE_POOL_SIZE=2000
TERRITORY_FEE_POOL_SIZE=200
FEE_POOL_TOPUP_THRESHOLD=100

# --- Cold storage (Workstream B) ---
# Offline ops/cold wallet the weekly distribution sweeps the hot wallet to so the
# hot wallet trends to ~zero between cycles (§6.4). Commit only the public address
# here; the cold spend key NEVER touches a server. Consumed by Workstream B's ops
# sweep; leave empty until that lands and the wallet is generated (Task A6).
REWARDS_COLD_STORAGE_ADDRESS=

# VIEWKEY_MASTER_KEY — AES-256-GCM envelope master key for every MoneroViewKey
# row. Set in gitignored .env.local, never here (this file is tracked in git).
# MUST be backed up (escrowed): an offline copy AND an
# encrypted blob (scripts/backup-master-key.sh) stored separately from the DB
# backups. Losing it is unrecoverable data loss.

# DB_ARCHIVE_MODE — set DB_ARCHIVE_MODE=on in .env.local to enable Postgres WAL
# archiving + PITR (a separate failure domain from the nightly pg_dump). Off by
# default; enabling requires a base backup + offsite WAL shipping. See
# the internal ops docs (postgres durability).
